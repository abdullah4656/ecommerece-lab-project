<%- include('partials/header') %>

    <section class="success-page">
        <div class="container">
            <div class="success-card">
                <div class="success-icon">✓</div>
                <h1>Order Submitted Successfully!</h1>
                <p>Thank you for your custom coat order. We've received your request and will contact you within 24
                    hours.</p>

                <div class="next-steps">
                    <h3>What happens next?</h3>
                    <ul>
                        <li>📧 You'll receive a confirmation email shortly</li>
                        <li>📏 We'll send you a measurement guide</li>
                        <li>💰 A detailed price quote will be provided</li>
                        <li>⏱️ Production takes 3-4 weeks after confirmation</li>
                    </ul>
                </div>

                <div class="action-buttons">
                    <a href="/" class="btn-primary">Return to Home</a>
                    <a href="/products" class="btn-outline">Browse Products</a>
                </div>
            </div>
        </div>
    </section>

    <style>
        .success-page {
            padding: 80px 0;
            background: #f5f5f5;
            min-height: 60vh;
            display: flex;
            align-items: center;
        }

        .success-card {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .success-icon {
            width: 80px;
            height: 80px;
            background: #28a745;
            color: white;
            font-size: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .success-card h1 {
            color: #333;
            margin-bottom: 15px;
        }

        .success-card>p {
            color: #666;
            margin-bottom: 30px;
        }

        .next-steps {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            text-align: left;
            margin: 30px 0;
        }

        .next-steps h3 {
            margin-bottom: 15px;
            color: #333;
        }

        .next-steps ul {
            list-style: none;
            padding: 0;
        }

        .next-steps li {
            padding: 8px 0;
            color: #666;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .btn-primary {
            background: #007bff;
            color: white;
            padding: 12px 24px;
            border-radius: 6px;
            text-decoration: none;
        }

        .btn-outline {
            border: 1px solid #007bff;
            color: #007bff;
            padding: 12px 24px;
            border-radius: 6px;
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .success-card {
                padding: 20px;
            }

            .action-buttons {
                flex-direction: column;
            }
        }
    </style>

    <%- include('partials/footer') %>