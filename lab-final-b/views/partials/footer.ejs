<button id="chatbotToggle" class="chatbot-toggle" type="button" aria-label="Open chat assistant">Chat</button>
<section id="chatbotPanel" class="chatbot-panel" aria-label="Coat and Craft Assistant">
  <header class="chatbot-header">
    <div>
      <strong>Coat and Craft Assistant</strong>
      <p>Ask about custom coats, sizes, personalization, orders, or shipping.</p>
    </div>
    <button id="chatbotClose" type="button" class="chatbot-close" aria-label="Close chat">×</button>
  </header>
  <div id="chatbotBody" class="chatbot-body">
    <div class="chatbot-msg bot">
      <p>Hello! I am your local store assistant. Ask me about products, personalization, orders, shipping, SEO, or blog ideas.</p>
    </div>
  </div>
  <div class="chatbot-prompts">
    <button type="button" class="chatbot-prompt"
      data-question="What sizes do you offer for overcoats?">Sizes</button>
    <button type="button" class="chatbot-prompt"
      data-question="How can I personalize my coat?">Personalization</button>
    <button type="button" class="chatbot-prompt"
      data-question="What is your return and exchange policy?">Returns & Exchanges</button>
    <button type="button" class="chatbot-prompt"
      data-question="How can I track my order status?">Track Orders</button>
    <button type="button" class="chatbot-prompt"
      data-question="What is the price range for custom coats?">Pricing</button>
    <button type="button" class="chatbot-prompt"
      data-question="Which coat style is best for winter or formal events?">Style Advice</button>
  </div>
  <form id="chatbotForm" class="chatbot-form">
    <input id="chatbotInput" type="text" placeholder="Type your question..." autocomplete="off" />
    <button type="submit">Send</button>
  </form>
</section>

<script src="/js/script.js"></script>
</body>

</html>