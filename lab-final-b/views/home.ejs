<%- include('partials/header') %>

  <section class="hero-icecream"
    style="background-image: url('/assets/homebannner.webp'); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div class="overlay"></div>
    <div class="container hero-grid">
      <div class="inner">
        <h1>Create your own custom coat. Feel free.</h1>
        <p>
          Live the experience everyone is talking about, book your appointment, get measured and create the coat,
          overcoat, trench coat or garment of your dreams, tailored to your measurements and designed by you.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn-primary">Book Appointment</a>
        </div>


      </div>

  </section>



  <section class="parallel-section">
    <div class="container">
      <h2 style="margin-bottom:0px" class="section-title">Your dream wardrobe, custom-made and designed by you
      </h2>
      <span style="background-color:rgb(255,255,255);color:rgb(33,33,33);font-size:14px;    display: flex;
    text-align: center;">
       Get ready to take your formalwear look to the next level and
            make it perfect. Choose from countless options to personalize all your tailored clothing and make it truly
            special with over 500 stunning fabrics. Design it exactly how you want, and in just 5-6 weeks you'll be
            trying it on at one of our clubs.
      </span>

      <div class="parallel-grid" style="margin-top:60px;">
        <div class="parallel-item">
         
          <img src="/assets/image2 (1).webp" alt="Classic Coat" class="parallel-image">
          <div class="parallel-overlay">
            <a style="color: white;
    font-size: 28px;
    font-weight: 600;
    margin: 0; text-decoration:none;"  href="/products">Classic Collection</a>
          </div>
        </div>
        <div class="parallel-item">
          <img src="/assets/image2 (2).webp" alt="Modern Coat" class="parallel-image">
          <div class="parallel-overlay">
              <a style="color: white;
    font-size: 28px;
    font-weight: 600;
    margin: 0; text-decoration:none;"  href="/products">Modern Collection</a>
          </div>
        </div>
      </div>
    </div>
  </section>




  <section class="catalog-showcase">
    <div class="container">
      <h2 class="section-title">Explore Coat Collection</h2>
      <p class="page-subtitle">Choose ypur dream coat
          </p>
      <div class="products-grid">
        <% if (featuredProducts && featuredProducts.length) { %>
          <% featuredProducts.forEach(product=> { %>
            <article class="product-card">
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image" />
              <h3>
                <%= product.name %>
              </h3>
              <p>
              </p>
              <p><strong>$<%= Number(product.price || 0).toFixed(2) %></strong></p>
              <a href="/products/<%= product._id %>" class="btn-primary">View Details</a>
            </article>
            <% }) %>
              <% } else { %>
                <article class="builder-card">
                  <h3>Collection is warming up</h3>
                  <p>Add garments from the admin dashboard and they will show here automatically.</p>
                  <a href="/admin/products" class="btn-primary">Open Dashboard</a>
                </article>
                <% } %>
      </div>
    </div>
  </section>

  <section class="build-steps">
    <div class="container">
      <h2 class="section-title">How Tailoring Works</h2>
      <div class="steps-wrap">
        <div class="step-item">
          <span>1</span>
          <h3>Browse Collection</h3>
          <p>Find your perfect silhouette from live styles managed in the admin dashboard.</p>
        </div>
        <div class="step-item">
          <span>2</span>
          <h3>Customize Details</h3>
          <p>Pick fabric, lining, buttons, and fit preferences with validation built into product pages.</p>
        </div>
        <div class="step-item">
          <span>3</span>
          <h3>Measure & Checkout</h3>
          <p>Input your measurements or book a fitting, then confirm and track order status after sign in.</p>
        </div>
        <div class="step-item">
          <span>4</span>
          <h3>Admin Updates Go Live</h3>
          <p>Any product or SEO update from dashboard reflects automatically on storefront pages.</p>
        </div>
      </div>
      <div class="center-cta">
      </div>
    </div>
  </section>

  <section class="custom-coat-section">
    <div class="custom-coat-container">
      <div class="custom-coat-text">
        <h2>Customize Your Coat</h2>
        <p>Your dream wardrobe, custom-made and designed by you.Create a coat that's uniquely yours! Choose fabric, style, and details to match your personality.</p>
            <a href="/products" class="btn-primary">Start Your Custom Coat</a>

      </div>

    </div>
  </section>
  <section class="faq-section">
    <div class="faq-container">

      <h2>Frequently asked questions (FAQ's)</h2>
      <p class="subtitle">Your questions answered in one minute. You deserve it.</p>

      <div class="faq-item">
        <button class="faq-question">
          What does the cost of a suit include?
          <span><svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.64645 2.64645C5.84171 2.45118 6.15829 2.45118 6.35355 2.64645L11.3536 7.64645C11.5488 7.84171 11.5488 8.15829 11.3536 8.35355L6.35355 13.3536C6.15829 13.5488 5.84171 13.5488 5.64645 13.3536C5.45118 13.1583 5.45118 12.8417 5.64645 12.6464L10.2929 8L5.64645 3.35355C5.45118 3.15829 5.45118 2.84171 5.64645 2.64645Z" fill="currentColor"></path>
                  </svg></span>
        </button>
        <div class="faq-answer">
          <p>The price includes fabric, tailoring, fittings, and delivery.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          How long does it take for a Bund to arrive after I order it?
          <span><svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.64645 2.64645C5.84171 2.45118 6.15829 2.45118 6.35355 2.64645L11.3536 7.64645C11.5488 7.84171 11.5488 8.15829 11.3536 8.35355L6.35355 13.3536C6.15829 13.5488 5.84171 13.5488 5.64645 13.3536C5.45118 13.1583 5.45118 12.8417 5.64645 12.6464L10.2929 8L5.64645 3.35355C5.45118 3.15829 5.45118 2.84171 5.64645 2.64645Z" fill="currentColor"></path>
                  </svg></span>
        </button>
        <div class="faq-answer">
          <p>Delivery usually takes 6–8 weeks after your appointment.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          How is payment made?
          <span><svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.64645 2.64645C5.84171 2.45118 6.15829 2.45118 6.35355 2.64645L11.3536 7.64645C11.5488 7.84171 11.5488 8.15829 11.3536 8.35355L6.35355 13.3536C6.15829 13.5488 5.84171 13.5488 5.64645 13.3536C5.45118 13.1583 5.45118 12.8417 5.64645 12.6464L10.2929 8L5.64645 3.35355C5.45118 3.15829 5.45118 2.84171 5.64645 2.64645Z" fill="currentColor"></path>
                  </svg></span>
        </button>
        <div class="faq-answer">
          <p>You can pay via card, bank transfer, or other supported methods.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          Can companions come to the appointment?
          <span><svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.64645 2.64645C5.84171 2.45118 6.15829 2.45118 6.35355 2.64645L11.3536 7.64645C11.5488 7.84171 11.5488 8.15829 11.3536 8.35355L6.35355 13.3536C6.15829 13.5488 5.84171 13.5488 5.64645 13.3536C5.45118 13.1583 5.45118 12.8417 5.64645 12.6464L10.2929 8L5.64645 3.35355C5.45118 3.15829 5.45118 2.84171 5.64645 2.64645Z" fill="currentColor"></path>
                  </svg></span>
        </button>
        <div class="faq-answer">
          <p>Yes, you're welcome to bring someone with you.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          If I have any questions, where can I ask them?
          <span><svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.64645 2.64645C5.84171 2.45118 6.15829 2.45118 6.35355 2.64645L11.3536 7.64645C11.5488 7.84171 11.5488 8.15829 11.3536 8.35355L6.35355 13.3536C6.15829 13.5488 5.84171 13.5488 5.64645 13.3536C5.45118 13.1583 5.45118 12.8417 5.64645 12.6464L10.2929 8L5.64645 3.35355C5.45118 3.15829 5.45118 2.84171 5.64645 2.64645Z" fill="currentColor"></path>
                  </svg></span>
        </button>
        <div class="faq-answer">
          <p>You can contact us via email or live chat anytime.</p>
        </div>
      </div>

    </div>
  </section>





  <%- include('partials/footer') %>