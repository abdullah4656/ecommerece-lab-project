<%- include('partials/header') %>

  <section class="hero-coat home-hero"
    style="background-image: url('/assets/homebannner.webp'); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div class="overlay"></div>
    <div class="container hero-grid">
      <div class="inner">
        <p class="hero-kicker hero-animate hero-animate-1">Bespoke outerwear</p>
        <h1 class="hero-animate hero-animate-2">Create your own custom coat. Feel free.</h1>
        <p class="hero-animate hero-animate-3">
          Live the experience everyone is talking about, book your appointment, get measured and create the coat,
          overcoat, trench coat or garment of your dreams, tailored to your measurements and designed by you.
        </p>
        <div class="hero-actions hero-animate hero-animate-4">
          <a href="/contact" class="btn-primary">Book Appointment</a>
          <a href="/products" class="btn-outline hero-btn-light">Shop Coats</a>
        </div>
      </div>
    </div>
  </section>

  <section class="parallel-section">
    <div class="container">
      <div class="parallel-intro animate-on-scroll">
        <h2 class="section-title">Your dream wardrobe, custom-made and designed by you</h2>
        <p class="parallel-lead">
          Get ready to take your formalwear look to the next level. Choose from countless options to personalize
          your tailored clothing with over 500 stunning fabrics — ready in about 5–6 weeks.
        </p>
      </div>

      <div class="parallel-grid">
        <div class="parallel-item animate-on-scroll" style="--stagger: 0">
          <img src="/assets/image2 (1).webp" alt="Classic Coat" class="parallel-image">
          <div class="parallel-overlay">
            <a href="/products" class="parallel-link">Classic Collection</a>
          </div>
        </div>
        <div class="parallel-item animate-on-scroll" style="--stagger: 1">
          <img src="/assets/image2 (2).webp" alt="Modern Coat" class="parallel-image">
          <div class="parallel-overlay">
            <a href="/products" class="parallel-link">Modern Collection</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="catalog-showcase">
    <div class="container">
      <div class="animate-on-scroll">
        <h2 class="section-title">Explore Coat Collection</h2>
        <p class="page-subtitle">Choose your dream coat</p>
      </div>
      <div class="products-grid">
        <% if (featuredProducts && featuredProducts.length) { %>
          <% featuredProducts.forEach((product, index) => { %>
            <article class="product-card animate-on-scroll" style="--stagger: <%= index %>">
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image" loading="lazy" />
              <h3><%= product.name %></h3>
              <p class="product-card-price"><strong>$<%= Number(product.price || 0).toFixed(2) %></strong></p>
              <a href="/products/<%= product._id %>" class="btn-primary">View Details</a>
            </article>
          <% }) %>
        <% } else { %>
          <article class="builder-card animate-on-scroll">
            <h3>Collection is warming up</h3>
            <p>Add garments from the admin dashboard and they will show here automatically.</p>
            <a href="/admin/products" class="btn-primary">Open Dashboard</a>
          </article>
        <% } %>
      </div>
    </div>
  </section>

  <section class="build-steps">
    <div class="container">
      <h2 class="section-title animate-on-scroll">How Tailoring Works</h2>
      <div class="steps-wrap">
        <div class="step-item animate-on-scroll" style="--stagger: 0">
          <span>1</span>
          <h3>Browse Collection</h3>
          <p>Find your perfect silhouette from live styles managed in the admin dashboard.</p>
        </div>
        <div class="step-item animate-on-scroll" style="--stagger: 1">
          <span>2</span>
          <h3>Customize Details</h3>
          <p>Pick fabric, lining, buttons, and fit preferences with validation built into product pages.</p>
        </div>
        <div class="step-item animate-on-scroll" style="--stagger: 2">
          <span>3</span>
          <h3>Measure & Checkout</h3>
          <p>Input your measurements or book a fitting, then confirm and track order status after sign in.</p>
        </div>
        <div class="step-item animate-on-scroll" style="--stagger: 3">
          <span>4</span>
          <h3>Admin Updates Go Live</h3>
          <p>Any product or SEO update from dashboard reflects automatically on storefront pages.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="custom-coat-section">
    <div class="custom-coat-container animate-on-scroll">
      <div class="custom-coat-text">
        <h2>Customize Your Coat</h2>
        <p>Your dream wardrobe, custom-made and designed by you. Create a coat that's uniquely yours — choose fabric, style, and details to match your personality.</p>
        <a href="/products" class="btn-primary">Start Your Custom Coat</a>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="faq-container">
      <div class="faq-header animate-on-scroll">
        <h2>Frequently asked questions</h2>
        <p class="subtitle">Your questions answered in one minute. You deserve it.</p>
      </div>

      <% const faqs = [
        { q: 'What does the cost of a suit include?', a: 'The price includes fabric, tailoring, fittings, and delivery.' },
        { q: 'How long does it take for a coat to arrive after I order it?', a: 'Delivery usually takes 6–8 weeks after your appointment.' },
        { q: 'How is payment made?', a: 'You can pay via card, bank transfer, or other supported methods at checkout.' },
        { q: 'Can companions come to the appointment?', a: "Yes, you're welcome to bring someone with you." },
        { q: 'If I have any questions, where can I ask them?', a: 'Contact us via email, our contact page, or the site chat assistant.' }
      ]; %>
      <% faqs.forEach((faq, index) => { %>
        <div class="faq-item animate-on-scroll" style="--stagger: <%= index %>">
          <button type="button" class="faq-question">
            <%= faq.q %>
            <span aria-hidden="true">
              <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5.64645 2.64645C5.84171 2.45118 6.15829 2.45118 6.35355 2.64645L11.3536 7.64645C11.5488 7.84171 11.5488 8.15829 11.3536 8.35355L6.35355 13.3536C6.15829 13.5488 5.84171 13.5488 5.64645 13.3536C5.45118 13.1583 5.45118 12.8417 5.64645 12.6464L10.2929 8L5.64645 3.35355C5.45118 3.15829 5.45118 2.84171 5.64645 2.64645Z" fill="currentColor"></path>
              </svg>
            </span>
          </button>
          <div class="faq-answer">
            <p><%= faq.a %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <%- include('partials/footer') %>
