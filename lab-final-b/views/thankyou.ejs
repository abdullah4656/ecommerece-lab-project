<%- include('partials/header') %>

<section class="thankyou-section">
  <div class="container">
    <div class="builder-card thankyou-card">
      <h1>Order Confirmed</h1>
      <p>Thanks <strong><%= order.name %></strong>. Your custom coat order has been received by Coat and Craft.</p>
      <p><strong>Plan:</strong> <%= order.plan === 'subscription' ? 'Recurring Delivery' : 'One-Time Order' %></p>
      <% if (order.selectedFlavours && order.selectedFlavours.length) { %>
        <p><strong>Customizations:</strong></p>
        <div class="flavour-chip-wrap">
          <% order.selectedFlavours.forEach(flavour => { %>
            <span class="flavour-chip"><%= flavour %></span>
          <% }) %>
        </div>
      <% } %>
      <p>Receipt sent to: <strong><%= order.email || 'No email provided' %></strong></p>
      <div class="hero-actions">
        <a href="/products" class="btn-primary">Shop More Coats</a>
        <a href="/" class="btn-outline">Back to Home</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
