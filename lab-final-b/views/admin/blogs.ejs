<%- include('partials/header') %>

<section>
  <div class="admin-row">
    <h1>Blog Management</h1>
    <a href="/admin/blogs/add" class="admin-btn">Create New Post</a>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Image</th>
        <th>Status</th>
        <th>AI Draft</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (blogs && blogs.length) { %>
        <% blogs.forEach((blog) => { %>
          <tr>
            <td><%= blog.title %></td>
            <td><% if (blog.image) { %><img src="<%= blog.image %>" alt="" class="blog-image-preview" /><% } else { %>—<% } %></td>
            <td><%= blog.isPublished ? 'Published' : 'Draft' %></td>
            <td><%= blog.generatedByAI ? 'Yes' : 'No' %></td>
            <td><%= new Date(blog.createdAt).toLocaleDateString() %></td>
            <td>
              <a href="/admin/blogs/<%= blog._id %>/edit" class="admin-btn admin-btn-outline admin-btn-sm">Edit</a>
              <form action="/admin/blogs/<%= blog._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this blog post?');">
                <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="6">No blog posts created yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
