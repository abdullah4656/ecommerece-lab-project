<%- include('partials/header') %>

<section class="page-section">
  <div class="container">
    <h1>My Wishlist</h1>
    <p>All your saved coats in one place. Review, remove, or continue to customization.</p>

    <% if (items && items.length) { %>
      <div class="products-grid">
        <% items.forEach((item) => { %>
          <article class="product-card">
            <img src="<%= item.product.image %>" alt="<%= item.product.name %>" class="product-image" />
            <h3><%= item.product.name %></h3>
            <p><strong>$<%= Number(item.product.price || 0).toFixed(2) %></strong></p>
            <a href="/products/<%= item.product._id %>" class="btn-primary">View Coat</a>
            <form method="POST" action="/wishlist/toggle/<%= item.product._id %>" class="inline-form">
              <button type="submit" class="btn-outline">Remove</button>
            </form>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <article class="builder-card">
        <h2>No saved coats yet</h2>
        <p>Browse the collection and add coats you want to revisit later.</p>
        <a href="/products" class="btn-primary">Browse Coats</a>
      </article>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
