<%- include('partials/header') %>

<section class="page-section">
  <div class="container">
    <h1>Coat Collection</h1>
    <p>Discover premium coats, compare fabrics and finishes, and move confidently from selection to checkout.</p>

    <form method="GET" action="/products" class="search-form">
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Search coats, fabrics, styles..." />
      <button type="submit" class="btn-primary">Search</button>
    </form>

    <div id="boxConfigModal" class="box-modal" hidden>
      <div class="box-modal-panel">
        <h3>Customize Your Coat</h3>
        <p class="muted" id="boxModalProductName">Choose one base fabric and your customization options.</p>
        <div class="box-modal-grid">
          <div>
            <h4>Choose Base Fabric</h4>
            <div class="box-options-grid" id="boxBaseOptions"></div>
          </div>
          <div>
            <h4 id="boxFlavourLimitLabel">Choose Options (up to 3)</h4>
            <div class="box-options-grid" id="boxFlavourOptions"></div>
          </div>
        </div>
        <p class="muted" id="boxModalStatus">Select 1 base fabric and options to continue.</p>
        <div class="box-modal-actions">
          <button type="button" class="btn-outline" id="boxModalCancel">Cancel</button>
          <button type="button" class="btn-primary" id="boxModalConfirm" disabled>Add to Cart</button>
        </div>
      </div>
    </div>

    <div class="products-grid">
      <% if (products && products.length) { %>
        <% products.forEach((product) => { %>
          <article
            class="product-card coat-card"
            data-product-id="<%= product._id %>"
            data-name="<%= product.name %>"
            data-price="<%= product.price %>"
            data-flavours="<%= (product.flavourOptions || []).map(f => f.name).join('|') %>"
          >
            <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image" />
            <h3><%= product.name %></h3>
            <p class="muted"><%= product.shortDescription || product.description %></p>
            <p><strong>$<%= Number(product.price || 0).toFixed(2) %></strong></p>
            <a href="/products/<%= product._id %>" class="btn-outline">View Details</a>
            <button type="button" class="btn-primary box-config-btn">Customize &amp; Add</button>
          </article>
        <% }) %>
      <% } else { %>
        <p>No coats match your search. Try another term or check back soon.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
